# S3 互換ストレージ（SeaweedFS）への接続設定。
# このファイルをコピーして .env を作り、空欄を埋める（docs/setup/01-storage.md 手順 1）。
# .env は .gitignore 済み。実際のキーをこのファイル（.env.example）に書かないこと。
#
# aws CLI v2 はこれらの環境変数をそのまま読む。

# port-forward（kubectl -n storage port-forward svc/seaweedfs-all-in-one 8333:8333）経由の接続先。NodePort を使う場合は http://<ノードIP>:30833 など
AWS_ENDPOINT_URL=http://localhost:8333
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# SeaweedFS はリージョンを見ないが、aws CLI が必須とするので S3 の既定値を入れておく
AWS_REGION=us-east-1

# 新しめの aws CLI はアップロード時に CRC 系のチェックサムを自動で付ける。
# S3 互換ストレージによっては未対応でエラーになるため、必要なときだけ付ける設定にしておく。
AWS_REQUEST_CHECKSUM_CALCULATION=when_required
AWS_RESPONSE_CHECKSUM_VALIDATION=when_required

# --- フェーズ 2: クラスタ内のパイプライン（Argo / Ray）用の S3 ユーザー ---
# raw は読み取りのみ、derived / argo-artifacts は読み書きの最小権限（platform/templates/seaweedfs-s3-config.json 参照）。
# クラスタには Secret pipeline-s3-credentials として渡す（docs/setup/02-pipeline.md 手順 4）
PIPELINE_AWS_ACCESS_KEY_ID=
PIPELINE_AWS_SECRET_ACCESS_KEY=

# --- フェーズ 2: コンテナレジストリ（GHCR = GitHub Container Registry、非公開） ---
# GitHub のユーザー名（小文字）
GHCR_USER=
# push 用（ホストでだけ使う）: classic PAT で write:packages（read:packages を含む）
GHCR_TOKEN=
# pull 用（クラスタの imagePullSecret に入れる）: classic PAT で read:packages だけ
GHCR_PULL_TOKEN=
# 変換器イメージの CPU アーキテクチャ（クラスタのノードに合わせる。例: linux/arm64 / linux/amd64）。
# 空なら push 時は linux/amd64,linux/arm64 の両方を作る
CONVERTER_PLATFORM=
